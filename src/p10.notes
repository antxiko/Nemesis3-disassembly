# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6000 sonido_arranca el motor de sonido: lo pone a cero
L 0x6003 sonido_pide el motor de sonido: arranca el sonido A
L 0x6006 sonido_cuadro el motor de sonido: un cuadro de los ocho canales
C 0x61F9 el mapper: pone en 0x8000 el banco de A
C 0x6204 el mapper: pone en 0x8000 el banco de A
C 0x6212 apunta a el estado del sonido (pausa, fundido...)
C 0x6280 el mapper: pone en 0x8000 el banco de A
C 0x629A el mapper: pone en 0x8000 el banco de A
C 0x62BD guarda que banco de partituras va en 0xA000 (0: 12, 1: 13, 2: 9, otro: 25)
C 0x62C5 guarda que banco de partituras va en 0xA000 (0: 12, 1: 13, 2: 9, otro: 25)
C 0x62CB guarda que banco de partituras va en 0xA000 (0: 12, 1: 13, 2: 9, otro: 25)
C 0x62D1 guarda que banco de partituras va en 0xA000 (0: 12, 1: 13, 2: 9, otro: 25)
C 0x62DE lee que banco de partituras va en 0xA000 (0: 12, 1: 13, 2: 9, otro: 25)
C 0x62EE el mapper: pone en 0xA000 el banco de A
C 0x62F5 el mapper: pone en 0xA000 el banco de A
C 0x62FC el mapper: pone en 0xA000 el banco de A
C 0x6313 el mapper: pone en 0x8000 el banco de A
C 0x632D el mapper: pone en 0x8000 el banco de A
C 0x6365 apunta a una cuenta de cuadros del sonido
C 0x636F pone a uno el bit 7 de las marcas IX+0F (la envolvente de volumen; bit 7: onda nueva al SCC)
C 0x6377 pone a uno el bit 7 de las marcas IX+0F (la envolvente de volumen; bit 7: onda nueva al SCC)
C 0x637F pone a uno el bit 7 de las marcas IX+0F (la envolvente de volumen; bit 7: onda nueva al SCC)
C 0x6387 pone a uno el bit 7 de las marcas IX+0F (la envolvente de volumen; bit 7: onda nueva al SCC)
C 0x63A9 apunta a los 8 canales de sonido (0x40 bytes cada uno)
C 0x6408 lee el sonido del canal (0: callado; p10:612B)
C 0x6428 resta 1 a la cuenta de la nota
C 0x642B lee la cuenta de la nota
C 0x6439 resta 1 a la cuenta de la nota (alto)
C 0x643F lee la cuenta de la nota (alto)
C 0x6481 suma 1 a la cuenta de la nota (alto)
C 0x64B3 guarda el divisor de la nota (alto)
C 0x64C4 lee las marcas IX+0D (bits 0-1 tono y ruido, 2-3 la envolvente del PSG, 4-7 la onda que cambia)
C 0x64C9 guarda las marcas IX+0D (bits 0-1 tono y ruido, 2-3 la envolvente del PSG, 4-7 la onda que cambia)
C 0x64CC pone a uno el bit 1 de las marcas IX+0D (bits 0-1 tono y ruido, 2-3 la envolvente del PSG, 4-7 la onda que cambia)
C 0x64D4 lee las marcas IX+0D (bits 0-1 tono y ruido, 2-3 la envolvente del PSG, 4-7 la onda que cambia)
C 0x64D9 guarda las marcas IX+0D (bits 0-1 tono y ruido, 2-3 la envolvente del PSG, 4-7 la onda que cambia)
C 0x650C guarda el divisor de la nota (alto)
C 0x6526 guarda el divisor de la nota (alto)
C 0x654E guarda el volumen de la nota
C 0x659A mira el bit 2 de el modo del canal (orden 0xFE)
C 0x65A1 mira el bit 3 de el modo del canal (orden 0xFE)
C 0x65A8 mira el bit 4 de el modo del canal (orden 0xFE)
C 0x65AF lee la octava, para elegir el guion de bateria
C 0x65C4 lee la octava, para elegir el guion de bateria
C 0x65D9 lee la octava, para elegir el guion de bateria
C 0x65EF guarda por donde va la partitura (bajo)
C 0x65F2 guarda por donde va la partitura (alto)
C 0x65F9 pone a cero el bit 4 de las marcas IX+0E (bateria, desafinado, vibrato, periodo del SCC, volumen restado)
C 0x65FD mira el bit 4 de las marcas del deslizamiento (bit 6 en marcha, 7 hacia arriba)
C 0x6604 pone a uno el bit 6 de las marcas del deslizamiento (bit 6 en marcha, 7 hacia arriba)
C 0x6611 guarda las marcas IX+0F (la envolvente de volumen; bit 7: onda nueva al SCC)
C 0x6615 guarda hacia donde va el vibrato
C 0x6618 guarda la cuenta del vibrato
C 0x661B guarda por donde va la onda que cambia (0-0x1F)
C 0x661E guarda la cuenta de la onda que cambia
