# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
C 0xA066 guarda cuantos enemigos hay
C 0xA069 guarda cuantos sprites usan los enemigos (tope 12)
C 0xA06C apunta a los enemigos (12 de 0x40)
C 0xA078 apunta a las piezas (8 de 0x20)
C 0xA09D guarda el caracter del fondo de la fase
C 0xA0A6 lee el estado de la nave (1 normal, 2 y 3 con escudo, 0xFF estalla)
C 0xA0AB sonido_4C: pide el sonido 0x4C
C 0xA0AE lee las explosiones grandes (4 de 8 bytes)
C 0xA0B6 lee la fase (1 a 11)
C 0xA0BD lee el jefe de la fase 4 (0 a 3)
