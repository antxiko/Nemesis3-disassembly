# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
C 0x8088 lee la fase (1 a 11)
C 0x809B lee la fase (1 a 11)
C 0x80ED bancos_19: pone el 19 (y sus copias en 0xF0F1-3)
C 0x80F0 lee la fase (1 a 11)
C 0x80F6 lee_palabra: HL = la palabra A de la tabla HL
C 0x80FE suma_a_hl: HL = HL + A
C 0x8108 bancos_1_2_3: pone los bancos 1-2-3 (y sus copias en 0xF0F1-3)
C 0x810B lee la posicion del scroll (16 bits)
C 0x8110 lee la fase (1 a 11)
C 0x812D lee el estado de la nave (0xFF: estalla)
C 0x815A suma_a_hl: HL = HL + A
C 0x81A2 lee la cuenta de cuadros del juego
C 0x822F bancos_8: pone el 8 (y sus copias en 0xF0F1-3)
C 0x824D bancos_1_2_3: pone los bancos 1-2-3 (y sus copias en 0xF0F1-3)
C 0x825B bancos_19: pone el 19 (y sus copias en 0xF0F1-3)
