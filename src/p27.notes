# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x83CF consola_paso_siguiente el paso siguiente de la consola entre fases (0xE322)
L 0x83D7 consola_subpaso_siguiente el subpaso siguiente de la consola (0xE323)
L 0x8410 final_paso_siguiente el paso siguiente del final (0xE329)
L 0x8418 final_subpaso_siguiente el subpaso siguiente del final (0xE32A)
L 0x8CBF contador_loco el contador cambia al azar cada 4 cuadros
C 0x804F despacha: salta a la palabra A de la tabla que va detras del call
C 0x805E bufer_a_vram: el bufer de 0xCA00 a la tabla de nombres, la pantalla entera
C 0x8064 consola_cuadro: la consola, un cuadro
C 0x8068 despacha: salta a la palabra A de la tabla que va detras del call
C 0x8078 bancos_29: pone el 29 (y sus copias en 0xF0F1-3)
